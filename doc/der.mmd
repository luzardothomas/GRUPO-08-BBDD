    }
    pieza_publicitaria {
        int pieza_id PK
        int campania_id FK
        varchar idioma
        int pais_mercado_id FK
        numeric costo_tarifa
    }
    espacio_publicitario {
        int espacio_id PK
        int partido_id FK
        int numero_espacio
        int pieza_id FK
        int orden_prioridad
        datetimeoffset fecha_exhibicion
        bit facturado
        numeric monto_facturado
    }
    partido {
        int partido_id PK
        int sede_id FK
        datetimeoffset fecha_hora_local
        datetimeoffset fecha_hora_utc
        varchar fase
        int seleccion_local_id FK
        int seleccion_visitante_id FK
        varchar estado
        int goles_local
        int goles_visitante
        int penales_local
        int penales_visitante
        int asistencia_publico
    }

