        int seleccion_id FK
        int jugador_id FK
        int asistencia_jugador_id FK
        int minuto
        varchar tipo_gol
        varchar periodo
    }
    tarjeta {
        int tarjeta_id PK
        int partido_id FK
        int seleccion_id FK
        int jugador_id FK
        int minuto
        varchar tipo
        varchar motivo
        varchar tipo_expulsion
    }
