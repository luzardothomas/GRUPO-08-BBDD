        int tarjeta_id FK
        int partido_afectado_id FK
        varchar motivo
        datetimeoffset fecha_generada
    }
    arbitro {
        int arbitro_id PK
        varchar nombre
        varchar apellido
        date fecha_nacimiento
        int pais_id FK
        varchar categoria
    }
    arbitro_idioma {
        int arbitro_id PK,FK
        varchar idioma PK
    }
    designacion_arbitral {
        int designacion_id PK
        int partido_id FK
        int arbitro_id FK
        varchar rol
    }
    informe_arbitral {
        int informe_id PK
        int designacion_id FK
